# Database (used by docker-compose; override if running Postgres yourself)
DATABASE_URL=postgresql://maritime:maritime@db:5432/maritime?schema=public
POSTGRES_USER=maritime
POSTGRES_PASSWORD=maritime
POSTGRES_DB=maritime

# LLM provider: mock (default, no key needed), anthropic, or openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Leave empty for the provider default (anthropic: claude-sonnet-5-5, openai: gpt-5-mini)
LLM_MODEL=
# Per-request timeout for LLM calls (ms). Each call is retried at most once.
LLM_TIMEOUT_MS=30000

# Simulation
# 1 real second = SIM_SPEED sim minutes of vessel movement
SIM_SPEED=120

# Economics assumptions (shown in the UI as assumptions; both prices are editable in Settings)
FUEL_PRICE_EUR_PER_T=600
CO2_FACTOR=3.114
# EU Allowance price, EUR per tonne CO2 (EU ETS cost of each scenario)
EUA_PRICE_EUR_PER_T=90

# Weather for scenarios A/B/C: open-meteo (real marine forecast, no key) or mock (offline)
WEATHER_PROVIDER=open-meteo
WEATHER_TIMEOUT_MS=6000

# Live AIS tracking via aisstream.io. Put your key ONLY in .env (git-ignored), never in code.
# Empty = live tracking off; vessels follow the simulation.
AISSTREAM_API_KEY=
# Minimum minutes between automatic ETA/scenario recomputes per tracked vessel
AIS_RECOMPUTE_MINUTES=10

# API (inside the container)
PORT=4000

# Host port for the web UI (docker compose)
WEB_PORT=8080
