generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VoyageStatus {
  PLANNED
  UNDERWAY
  ARRIVED
  CANCELLED
}

enum PortEventType {
  BERTH_DELAY
  CONGESTION
  CLOSURE
  BUNKER_OFFER
  NONE
}

enum RecommendationActionType {
  ADJUST_SPEED
  BUNKER_DETOUR
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CiiRating {
  A
  B
  C
  D
  E
}

model Port {
  id            String      @id @default(cuid())
  unlocode      String      @unique
  name          String
  country       String
  lat           Float
  lon           Float
  originVoyages Voyage[]    @relation("OriginPort")
  destVoyages   Voyage[]    @relation("DestPort")
  portEvents    PortEvent[]
}

model Vessel {
  id                  String   @id @default(cuid())
  imo                 String   @unique
  name                String
  type                String
  dwt                 Float
  designSpeedKn       Float
  minSpeedKn           Float
  fuelTPerDayAtDesign Float
  auxFuelTPerDay      Float
  /// Year-to-date CO2 (t) and distance (nm), for the annual CII projection.
  ytdCo2T             Float?
  ytdDistanceNm       Float?
  /// Maritime Mobile Service Identity; links the vessel to live AIS (aisstream.io).
  mmsi                String?  @unique
  /// Latest AIS fix.
  aisLat              Float?
  aisLon              Float?
  aisSogKn            Float?
  aisCogDeg           Float?
  aisAt               DateTime?
  voyages             Voyage[]
}

model Voyage {
  id               String       @id @default(cuid())
  vessel           Vessel       @relation(fields: [vesselId], references: [id])
  vesselId         String
  originPort       Port         @relation("OriginPort", fields: [originPortId], references: [id])
  originPortId     String
  destPort         Port         @relation("DestPort", fields: [destPortId], references: [id])
  destPortId       String
  departedAt       DateTime
  speedKn          Float
  sailedNmAtRebase Float        @default(0)
  rebasedAt        DateTime     @default(now())
  plannedEta       DateTime
  berthTime        DateTime?
  /// Sea route [{lat, lon}, ...] from origin to destination port (searoute-js).
  routeCoords      Json?
  /// Length of routeCoords in nautical miles.
  routeNm          Float?
  status           VoyageStatus @default(UNDERWAY)
  ciiAttained      Float?    
  ciiRating        CiiRating?
  createdAt        DateTime     @default(now())

  portEvents      PortEvent[] @relation("VoyagePortEvents")
  recommendations Recommendation[]
  charterParty    CharterParty?
}

/// Voyage charter party: the source text and the terms read from it.
model CharterParty {
  id               String   @id @default(cuid())
  voyage           Voyage   @relation(fields: [voyageId], references: [id])
  voyageId         String   @unique
  sourceName       String
  text             String
  /// CharterPartyTerms (packages/shared/src/charterParty.ts)
  terms            Json
  /// Expected cargo-operations hours at the discharge berth (operator input).
  expectedOpsHours Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Email {
  id         String   @id @default(cuid())
  fromAddr   String
  subject    String
  body       String
  receivedAt DateTime @default(now())
  processed  Boolean  @default(false)
  queued     Boolean  @default(false)
  createdAt  DateTime @default(now())

  portEvents PortEvent[]
}

model PortEvent {
  id             String        @id @default(cuid())
  email          Email         @relation(fields: [emailId], references: [id])
  emailId        String
  port           Port?         @relation(fields: [portId], references: [id])
  portId         String?
  voyage         Voyage?       @relation("VoyagePortEvents", fields: [voyageId], references: [id])
  voyageId       String?
  eventType      PortEventType
  delayHours     Float?
  newBerthTime   DateTime?
  /// Bunker-offer fields (eventType BUNKER_OFFER); null for other events.
  fuelGrade      String?
  priceUsdPerT   Float?
  qtyMinT        Float?
  qtyMaxT        Float?
  validUntil     DateTime?
  supplier       String?
  rawExtraction  Json
  sourceSpans    Json
  confidence     Float
  createdAt      DateTime      @default(now())

  recommendations Recommendation[]
}

model Recommendation {
  id                 String                   @id @default(cuid())
  voyage             Voyage                   @relation(fields: [voyageId], references: [id])
  voyageId           String
  portEvent          PortEvent                @relation(fields: [portEventId], references: [id])
  portEventId        String
  actionType         RecommendationActionType @default(ADJUST_SPEED)
  currentSpeedKn     Float
  recommendedSpeedKn Float
  fuelSavedT         Float
  costSavedEur       Float
  co2SavedT          Float
  calc               Json
  /// ScenarioSet A/B/C (packages/shared/src/scenarios.ts)
  scenarios          Json?
  /// Scenario approved ("B" or "C"); null while pending/rejected.
  chosenScenario     String?
  etsSavedEur        Float                    @default(0)
  /// Demurrage avoided vs baseline, in the charter party's currency.
  demurrageAvoided   Float?
  rationale          String
  status             RecommendationStatus     @default(PENDING)
  rejectReason       String?
  decidedAt          DateTime?
  createdAt          DateTime                 @default(now())
  outboundEmails     OutboundEmail[]
}

enum OutboundEmailStatus {
  DRAFT
  SENT
  WITHDRAWN
}

/// Notice to charterers and agent, drafted automatically on approval.
model OutboundEmail {
  id               String              @id @default(cuid())
  recommendation   Recommendation      @relation(fields: [recommendationId], references: [id])
  recommendationId String
  toAddrs          String
  ccAddrs          String
  subject          String
  body             String
  status           OutboundEmailStatus @default(DRAFT)
  sentAt           DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  payload   Json
  createdAt DateTime @default(now())
}

/// Single-row app settings (id is always 1).
model Settings {
  id               Int      @id @default(1)
  fuelPriceEurPerT Float
  euaPriceEurPerT  Float    @default(90)
  co2Factor        Float
  /// Bunker offers are quoted in USD/t.
  usdEurRate        Float    @default(0.92)
  bunkerPortHours   Float    @default(8)
  bunkerPortFeeEur  Float    @default(5000)
  bunkerDefaultQtyT Float    @default(800)
  updatedAt        DateTime @updatedAt
}
